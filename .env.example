# QuizKeen environment template — copy to `.env.local` and fill in.
# Values for a Supabase project + its Postgres connection string.

# Public (safe to expose to the browser; prefixed NEXT_PUBLIC_)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-or-publishable-key"

# Server-only (never expose to the client)
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_JWKS_URL="https://your-project-id.supabase.co/auth/v1/.well-known/jwks.json"

# Postgres: use the *transaction* pooler (port 6543), not the direct host.
# The direct db.<ref>.supabase.co host is IPv6-only and the session pooler
# (port 5432) caps out at 15 clients, which Prisma trips over.
#
# connection_limit controls how many queries one server process may run at the
# same time. Measured against eu-west-1, where one query costs ~275ms:
#   connection_limit=1  -> four queries take ~1100ms (they queue up)
#   connection_limit=5  -> four queries take ~450ms  (they overlap)
# Keep it low (1-2) for serverless deploys, which run many short-lived
# instances; a single long-running server can afford 5.
DATABASE_URL="postgresql://postgres.<project-ref>:password@aws-1-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5"
